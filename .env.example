# Every setting sdlc reads. All are optional; defaults are shown. Run `sdlc config` to see effective values.
#
# Recommended: set these as USER environment variables (scripts/setup-env.ps1 on Windows, your shell
# profile on macOS/Linux) rather than in a file. Never commit real values. In GitHub Actions, store the
# SECRET ones as repository secrets and the rest as repository variables (see .github/workflows/ci.yml).

# --- provider -----------------------------------------------------------------
SDLC_PROVIDER=mock                    # mock | anthropic | openai
SDLC_MODEL=                           # anthropic default claude-opus-5-5; required for openai
SDLC_MAX_TOKENS=16000
SDLC_LLM_TIMEOUT=600
SDLC_OPENAI_BASE_URL=https://api.openai.com/v1
SDLC_OPENAI_API_VERSION=              # set for Azure OpenAI
ANTHROPIC_API_KEY=                    # SECRET
OPENAI_API_KEY=                       # SECRET

# --- orchestration limits -----------------------------------------------------
SDLC_MAX_LLM_CALLS=80
SDLC_MAX_ATTEMPTS=3
SDLC_WORKERS=4
SDLC_TEST_TIMEOUT=300
SDLC_GIT_TIMEOUT=120
SDLC_MAX_FILE_BYTES=200000
SDLC_MAX_FILES_PER_TASK=40

# --- paths and policy ---------------------------------------------------------
SDLC_HOME=                            # default: this checkout
SDLC_WORKSPACES_DIR=                  # default: <SDLC_HOME>/workspaces
SDLC_POLICY_FILE=                     # default: policies/auto.yaml

# --- security -----------------------------------------------------------------
SDLC_ALLOW_NETWORK=0                  # 1 lets generated code use the network
SDLC_DEPENDENCY_AUDIT=0               # 1 runs pip-audit on generated projects (needs network)

# --- observability ------------------------------------------------------------
SDLC_DEBUG=0                          # 1 saves redacted LLM prompts/answers per run
SDLC_ALERT_WEBHOOK=                   # SECRET: Slack / Teams / Mattermost / generic webhook URL
SDLC_ALERT_FORMAT=slack               # slack | json
SDLC_ALERT_MIN_SEVERITY=warning       # info | warning | error | critical

# --- GitHub (optional, real PRs) ----------------------------------------------
GITHUB_TOKEN=                         # SECRET
SDLC_GITHUB_REPO=                     # owner/name
